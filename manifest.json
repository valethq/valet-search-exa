{
  "schema": 1,
  "id": "valet-search-exa",
  "name": "Exa Search",
  "version": "0.1.0",
  "description": "web_search_exa and web_fetch_exa tools backed by the Exa API.",
  "repository": "https://github.com/valethq/valet-search-exa",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "provides": ["tools@1", "settings@1"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "x-group": "tools",
    "x-icon": "search",
    "properties": {
      "secret": {
        "type": "string",
        "title": "API key secret",
        "description": "Secret name (~/.valet/secrets/<name>, then env <NAME>).",
        "default": "exa_api_key",
        "x-widget": "secret"
      },
      "baseUrl": {
        "type": "string",
        "title": "Base URL",
        "description": "Exa API base URL. Override for tests or a proxy.",
        "default": "https://api.exa.ai",
        "x-advanced": true
      },
      "mode": {
        "type": "string",
        "title": "Mode",
        "description": "Exa's search mode or depth.",
        "enum": ["auto", "fast", "deep"],
        "enumNames": ["Auto", "Fast", "Deep"],
        "default": "auto"
      },
      "numResults": {
        "type": "integer",
        "title": "Results per search",
        "description": "Default number of hits web_search_exa returns.",
        "default": 8,
        "minimum": 1,
        "maximum": 25
      },
      "maxCharacters": {
        "type": "integer",
        "title": "Excerpt characters",
        "description": "Per result. web_fetch_exa uses four times this.",
        "default": 2000,
        "minimum": 100,
        "maximum": 50000
      },
      "timeoutMs": {
        "type": "integer",
        "title": "Timeout (ms)",
        "description": "Per-request timeout for search and fetch.",
        "default": 30000,
        "minimum": 1000,
        "maximum": 300000
      },
      "minRole": {
        "type": "string",
        "title": "Lowest role with access",
        "description": "Runs below this role do not see the tools.",
        "enum": ["owner", "trusted", "guest"],
        "enumNames": ["Owner only", "Trusted and owner", "Everyone"],
        "default": "trusted"
      }
    }
  }
}
