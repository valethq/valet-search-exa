{
  "schema": 1,
  "id": "valet-search-exa",
  "name": "Exa Search",
  "version": "0.1.0",
  "description": "web_search_exa and web_fetch_exa tools backed by the Exa API.",
  "repository": "https://github.com/valethq/valet-search-exa",
  "valet": "^0.1.1",
  "main": "./src/index.ts",
  "provides": ["tools@1"],
  "acl": {
    "permissions": {
      "query": {
        "summary": "Run web searches with Exa",
        "default": "guest"
      }
    }
  },
  "settings": {
    "sections": {
      "tools": {
        "subsections": [
          {
            "id": "search",
            "label": "Search",
            "items": [
              {
                "id": "apiKey",
                "label": "API key",
                "summary": "Stored as a valet secret; the default reads ~/.valet/secrets/exa_api_key or $EXA_API_KEY.",
                "input": {
                  "type": "secret",
                  "default": "${secret:exa_api_key}"
                },
                "migrate": [
                  {
                    "from": "secret",
                    "map": {
                      "template": "${secret:{}}"
                    }
                  }
                ]
              },
              {
                "id": "baseUrl",
                "label": "Base URL",
                "summary": "Exa API base URL. Override for tests or a proxy.",
                "input": {
                  "type": "string",
                  "default": "https://api.exa.ai"
                },
                "advanced": true
              },
              {
                "id": "mode",
                "label": "Mode",
                "summary": "Exa's search mode or depth.",
                "input": {
                  "type": "select",
                  "options": [
                    {
                      "value": "auto",
                      "label": "Auto"
                    },
                    {
                      "value": "fast",
                      "label": "Fast"
                    },
                    {
                      "value": "deep",
                      "label": "Deep"
                    }
                  ],
                  "default": "auto"
                }
              },
              {
                "id": "numResults",
                "label": "Results per search",
                "summary": "Default number of hits web_search_exa returns.",
                "input": {
                  "type": "int",
                  "min": 1,
                  "max": 25,
                  "default": 8
                }
              },
              {
                "id": "maxCharacters",
                "label": "Excerpt characters",
                "summary": "Per result. web_fetch_exa uses four times this.",
                "input": {
                  "type": "int",
                  "min": 100,
                  "max": 50000,
                  "default": 2000
                }
              },
              {
                "id": "timeoutMs",
                "label": "Timeout (ms)",
                "summary": "Per-request timeout for search and fetch.",
                "input": {
                  "type": "duration",
                  "min": 1000,
                  "max": 300000,
                  "default": 30000
                }
              },
              {
                "id": "minRole",
                "label": "Lowest role with access",
                "summary": "Runs below this role do not see the tools.",
                "input": {
                  "type": "select",
                  "options": [
                    {
                      "value": "owner",
                      "label": "Owner only"
                    },
                    {
                      "value": "trusted",
                      "label": "Trusted and owner"
                    },
                    {
                      "value": "guest",
                      "label": "Everyone"
                    }
                  ],
                  "default": "trusted"
                }
              }
            ]
          }
        ],
        "icon": "search"
      }
    }
  }
}
